      <dataObjectReference dataObjectRef="sid-64b0f776-b24b-4b93-81b5-e28bd38c98d2" id="sid-3D6FEBD6-C95D-455F-8322-3E87A5B5D71A" name="ggf. im Vorfeld über ergänzende Medien informieren ¹">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
